processar_pergunta(\"aprenda: Qual a capital da França? = A cidade de Paris é a capital e a mais populosa da França.\")\n","print(f\"RAVENA: {resposta_aprender_2}\")\n","\n","# Teste 4: Aprender uma terceira resposta (com pequena variação)\n","print(\"\\nTeste 4: Aprender uma terceira resposta (variaçao)\")\n","resposta_aprender_3 = processar_pergunta(\"aprenda: Qual a capital da França? = Paris, conhecida como a cidade luz, é a capital da França.\")\n","print(f\"RAVENA: {resposta_aprender_3}\")\n","\n","# Teste 5: Consultar a pergunta novamente. Espera-se que a RAVENA escolha a resposta com maior confiança (e mais recente)\n","print(\"\\nTeste 5: Consultar novamente e esperar a melhor resposta\")\n","response_q1_b = processar_pergunta(\"Qual a capital da França?\")\n","print(f\"RAVENA: {response_q1_b}\")\n","\n","# Teste 6: Re-aprender uma das respostas anteriores para aumentar sua confiança\n","print(\"\\nTeste 6: Aumentar confiança de uma resposta existente\")\n","resposta_aprender_1_re = processar_pergunta(\"aprenda: Qual a capital da França? = Paris é a capital da França.\")\n","print(f\"RAVENA: {resposta_aprender_1_re}\")\n","\n","# Teste 7: Consultar novamente. Agora 'Paris é a capital da França.' deve ser preferida se sua confiança for maior.\n","print(\"\\nTeste 7: Consultar novamente após aumento de confiança\")\n","response_q1_c = processar_pergunta(\"Qual a capital da França?\")\n","print(f\"RAVENA: {response_q1_c}\")\n","\n","# Teste 8: Inserir uma pergunta similar com uma resposta para um tópico diferente, para verificar que não há conflito\n","print(\"\\nTeste 8: Adicionar pergunta em outro tópico\")\n","resposta_aprender_q2 = processar_pergunta(\"aprenda: Qual a capital do Brasil? = Brasília é a capital do Brasil.\")\n","print(f\"RAVENA: {resposta_aprender_q2}\")\n","\n","# Teste 9: Consultar a nova pergunta\n","print(\"\\nTeste 9: Consultar nova pergunta\")\n","response_q2 = processar_pergunta(\"Qual a capital do Brasil?\")\n","print(f\"RAVENA: {res