,"Ajuste 13: peso = 2.30\n","Ajuste 14: peso = 2.40\n","Ajuste 15: peso = 2.50\n","Ajuste 16: peso = 2.60\n","Ajuste 17: peso = 2.70\n","Ajuste 18: peso = 2.80\n","Ajuste 19: peso = 2.90\n","Ajuste 20: peso = 3.00\n","Ajuste 21: peso = 3.00\n","Ajuste 22: peso = 3.00\n","Ajuste 23: peso = 3.00\n","Ajuste 24: peso = 3.00\n","Ajuste 25: peso = 3.00\n","\n","--- Teste de PESO_MIN ---\n","Ajuste 1: peso = 0.95\n","Ajuste 2: peso = 0.90\n","Ajuste 3: peso = 0.85\n","Ajuste 4: peso = 0.80\n","Ajuste 5: peso = 0.75\n","Ajuste 6: peso = 0.70\n","Ajuste 7: peso = 0.65\n","Ajuste 8: peso = 0.60\n","Ajuste 9: peso = 0.55\n","Ajuste 10: peso = 0.50\n","Ajuste 11: peso = 0.50\n","Ajuste 12: peso = 0.50\n","Ajuste 13: peso = 0.50\n","Ajuste 14: peso = 0.50\n","Ajuste 15: peso = 0.50\n","Ajuste 16: peso = 0.50\n","Ajuste 17: peso = 0.50\n","Ajuste 18: peso = 0.50\n","Ajuste 19: peso = 0.50\n","Ajuste 20: peso = 0.50\n","Ajuste 21: peso = 0.50\n","Ajuste 22: peso = 0.50\n","Ajuste 23: peso = 0.50\n","Ajuste 24: peso = 0.50\n","Ajuste 25: peso = 0.50\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ec1066b0","executionInfo":{"status":"ok","timestamp":1774158794467,"user_tz":180,"elapsed":1611,"user":{"displayName":"Alexsander Soares","userId":"02559980314802003297"}},"outputId":"f95c1199-19a4-4d29-85e7-52cb966a0078"},"source":["print(\"\\n--- Testes de Confiança ---\")\n","\n","# Test 1: Teach a new fact and check initial confidence (should be 1.0)\n","print(\"\\n--- Teste 1: Aprendendo um novo fato ---\")\n","print(processar_pergunta(\"aprenda: Qual a cor do ceu? = O céu é azul.\"))\n","\n","# To verify, we need to load the knowledge item. This is usually internal, so we'll rely on next steps to confirm.\n","# We can't directly inspect 'memoria_do_topico' from here without modifying `aprender` to return it.\n","# Instead, we will observe the effect on scores later.\n","\n","# Test 2: Re-teach the same fact to see confidence increment\n","print(\"\\n--- Teste 2: Re-aprendendo o mesmo fato ---\")\n","print(processar_pergunta(\"aprenda: Qual a cor do ceu? = O céu é azul devido à dispersão da luz azul.\"))\n","\n","# Test 3: Query the fact multiple times to check if confidence (and peso/acessos) impacts score\n","print(\"\\n--- Teste 3: Consultando o fato e observando o score final ---\")\n","for i in range(1, 4):\n","    print(f\"\\nConsulta {i}:\")\n","    resposta_ceu = processar_pergunta(\"Qual a cor do ceu?\")\n","    print(f\"RAVENA: {resposta_ceu}\")\n","    # Expect to see 'DEBUG: Score final' in the output, which should reflect the confidence bonus.\n","\n","print(\"\\n--- Teste de Confiança Finalizado ---\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","--- Testes de Confiança ---\n","\n","--- Teste 1: Aprendendo um novo fato ---\n","LOG: Pergunta recebida: aprenda: Qual a cor do ceu? = O céu é azul.\n","Aprendido com sucesso.\n","\n","--- Teste 2: Re-aprendendo o mesmo fato ---\n","LOG: Pergunta recebida: aprenda: Qual a cor do ceu? = O céu é azul devido à dispersão da luz azul.\n","Atualizei essa informação!\n","\n","--- Teste 3: Consultando o fato e observando o score final ---\n","\n","Consulta 1:\n","LOG: Pergunta recebida: Qual a cor do ceu?\n","LOG: Pergunta reescrita: qual a cor do ceu?\n","DEBUG: Núcleo escolhido: geral\n","DEBUG: Score base: 1.1329999829345945\n","DEBUG: Score final: 1.1429999829345945\n","RAVENA: o céu é azul devido à dispersão da luz azul.\n","\n","Consulta 2:\n","LOG: Pergunta recebida: Qual a cor do ceu?\n","LOG: Pergunta reescrita: qual a cor do ceu?\n","DEBUG: Núcleo escolhido: geral\n","DEBUG: Score base: 1.1479998956591981\n","DEBUG: Score final: 1.1579998956591981\n","DEBUG: Núcleo escolhido: geral\n","DEBUG: Score base: 0.9849426624374585\n","DEBUG: Score final: 0.9949426624374585\n","RAVENA: o céu é azul devido à dispersão da luz azul.\n","\n","Consulta 3:\n","LOG: Pergunta recebida: Qual a cor do ceu?\n","LOG: Pe