)\n","\n","# Teste com intenção histórica\n","pergunta_hist = \"quem descobriu o brasil?\"\n","reescrita_hist = reescrever_pergunta(pergunta_hist)\n","print(f\"Original: '{pergunta_hist}' -> Reescrita: '{reescrita_hist}'\")\n","\n","# Teste com intenção geral (sem alteração significativa esperada)\n","pergunta_geral = \"qual a capital da frança?\"\n","reescrita_geral = reescrever_pergunta(pergunta_geral)\n","print(f\"Original: '{pergunta_geral}' -> Reescrita: '{reescrita_geral}'\")\n","\n","# Teste com pergunta sem palavras-chave específicas de intenção, mas com contexto\n","pergunta_contexto = \"fale sobre o avião\"\n","reescrita_contexto = reescrever_pergunta(pergunta_contexto)\n","print(f\"Original: '{pergunta_contexto}' -> Reescrita: '{reescrita_contexto}'\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["--- Testes da função reescrever_pergunta ---\n","Original: 'o que é fotossíntese?' -> Reescrita: 'o que é fotossíntese?'\n","Original: 'por que chove?' -> Reescrita: 'por que chove?'\n","Original: 'quem descobriu o brasil?' -> Reescrita: 'quem descobriu o brasil?'\n","Original: 'qual a capital da frança?' -> Reescrita: 'qual a capital da frança?'\n","Original: 'fale sobre o avião' -> Reescrita: 'fale sobre o avião'\n"]}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3a99da56","executionInfo":{"status":"ok","timestamp":1774148959229,"user_tz":180,"elapsed":2807,"user":{"displayName":"Alexsander Soares","userId":"02559980314802003297"}},"outputId":"5d315979-9a21-4e6f-db0b-91c6731825be"},"source":["print(\"\\n--- Teste de Ajuste de Peso: 'Quem foi Santos Dumont?' ---\")\n","for i in range(1, 7):\n","    print(f\"\\n--- Chamada {i} ---\")\n","    resposta = processar_pergunta(\"Quem foi Santos Dumont?\")\n","    print(f\"RAVENA: {resposta}\")"],"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","--- Teste de Ajuste de Peso: 'Quem foi Santos Dumont?' ---